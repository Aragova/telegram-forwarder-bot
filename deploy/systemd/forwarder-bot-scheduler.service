[Unit]
Description=Telegram Forwarder Bot Runtime Role: Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forwarder
Group=forwarder
WorkingDirectory=/opt/telegram-forwarder-bot
EnvironmentFile=/etc/forwarder-bot/forwarder.env
ExecStart=/usr/bin/python3 /opt/telegram-forwarder-bot/bot.py --role scheduler
Restart=on-failure
RestartSec=5
# Allow fenced DB operations to settle before systemd sends SIGKILL.
TimeoutStopSec=720
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
